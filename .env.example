# Run python3 scripts/setup.py to create .env privately.
# Optional legacy environment override. Prefer Dashboard > Setup & settings.
OPENCODE_GO_API_KEY=
ADMIN_PASSWORD=replace-with-a-long-random-password
BIND=127.0.0.1:8080
DATABASE_PATH=data/go-router.db
MODEL_CATALOG_PATH=config/models.json
DEFAULT_MODEL=deepseek/deepseek-v4.1-flash
GO_BASE_URL=https://opencode.ai/inference/go
# Exact browser origin. For local use: http://localhost:8080
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
MAX_CONCURRENT_REQUESTS=8
MAX_BODY_BYTES=20971520
MAX_RESPONSE_BYTES=16777216
REQUEST_TIMEOUT_SECONDS=600
STREAM_IDLE_TIMEOUT_SECONDS=90
LOG_BODIES=true
MAX_LOG_BYTES=65536
LOG_RETENTION_DAYS=30
# Display only. Subscription is a fixed monthly charge, not per-request cost.
MONTHLY_SUBSCRIPTION_USD=10
# Empty disables cross-origin browser access to the inference API.
# Comma-separated origins, or * for public API CORS. Admin is always same-origin.
CORS_ORIGINS=
# Used only by the optional Caddy HTTPS container.
DOMAIN=api.example.com

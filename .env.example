# Go Router configuration. Do not edit this template for a real install:
#   Linux/Docker: python3 scripts/setup.py --origin https://api.example.com
#   Windows:      scripts\install-windows.ps1 -Domain api.example.com
# Both create a private .env from this file with a random admin password.

# --- Required ---------------------------------------------------------------
# Dashboard password (at least 16 characters). Generated by the setup scripts.
ADMIN_PASSWORD=replace-with-a-long-random-password
# Listen address. Keep 127.0.0.1 so only the local HTTPS proxy can reach it.
BIND=127.0.0.1:8080
# Exact URL people open in the browser (scheme + host, no path). The admin
# dashboard rejects requests from any other origin.
PUBLIC_URL=http://localhost:8080
# true whenever PUBLIC_URL starts with https://
COOKIE_SECURE=false

# --- OpenCode Go -------------------------------------------------------------
# Leave empty and save the key in Dashboard > Setup & settings instead.
# A value here is used only if no key was ever saved in the dashboard.
OPENCODE_GO_API_KEY=
GO_BASE_URL=https://opencode.ai/inference/go
# Model used when a request omits "model".
DEFAULT_MODEL=deepseek/deepseek-v4.1-flash
# Display only: your fixed monthly Go price, shown beside per-request costs.
MONTHLY_SUBSCRIPTION_USD=10

# --- Storage -----------------------------------------------------------------
DATABASE_PATH=data/go-router.db
MODEL_CATALOG_PATH=config/models.json

# --- Limits ------------------------------------------------------------------
# Simultaneous upstream model calls; extra requests get HTTP 429.
MAX_CONCURRENT_REQUESTS=8
# Largest request body, including base64 images/audio (20 MiB).
MAX_BODY_BYTES=20971520
# Largest non-streamed response or single stream event (16 MiB).
MAX_RESPONSE_BYTES=16777216
REQUEST_TIMEOUT_SECONDS=600
STREAM_IDLE_TIMEOUT_SECONDS=90

# --- Request logs ------------------------------------------------------------
# Store request/response bodies (media removed, capped at MAX_LOG_BYTES each).
# Set to false to keep only metadata, usage and cost.
LOG_BODIES=true
MAX_LOG_BYTES=65536
# Detailed logs older than this are deleted; usage totals are kept.
LOG_RETENTION_DAYS=30

# --- Browser access ----------------------------------------------------------
# Empty: only server-side apps can call the API (recommended).
# Otherwise a comma-separated list of browser origins, or * for any origin.
CORS_ORIGINS=

# --- Docker HTTPS profile only -----------------------------------------------
# Domain for the bundled Caddy container (docker compose --profile https).
DOMAIN=api.example.com

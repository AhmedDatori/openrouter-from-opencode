[Unit]
Description=Go Router — OpenRouter-compatible OpenCode Go gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=go-router
Group=go-router
WorkingDirectory=/opt/go-router
EnvironmentFile=/opt/go-router/.env
ExecStart=/opt/go-router/go-router
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/go-router/data
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
